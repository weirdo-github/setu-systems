{
  "name": "setu-systems",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:start": "sh -c 'docker start setu-postgres >/dev/null 2>&1 || docker run --name setu-postgres -e POSTGRES_DB=setu_portal -e POSTGRES_USER=setu -e POSTGRES_PASSWORD=setu_dev -p 54322:5432 -v setu_postgres_data:/var/lib/postgresql/data -d postgres:16-alpine'",
    "db:stop": "docker stop setu-postgres",
    "db:logs": "docker logs -f setu-postgres",
    "db:migrate": "node --env-file=.env server/scripts/migrate-db.js",
    "db:seed": "node --env-file=.env server/scripts/seed-db.js",
    "db:discover:setup": "node --env-file=.env scripts/setup-db.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:discover:setup",
    "db:reset": "node --env-file=.env server/scripts/seed-db.js --force",
    "dev": "node --env-file=.env server/unified.js",
    "build": "next build",
    "start": "NODE_ENV=production node --env-file=.env server/unified.js",
    "lint": "eslint",
    "gmail:authorize": "node --env-file=.env server/scripts/authorize-gmail.js",
    "finance:sync": "node --env-file=.env scripts/syncFinanceStatus.js",
    "phase2:run": "node --env-file=.env scripts/run-phase2-local.mjs manual",
    "phase2:schedule": "node --env-file=.env scripts/phase2-scheduler.mjs",
    "deck:pitch": "node scripts/build-setu-pitch-deck.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.924.0",
    "@google-cloud/local-auth": "^3.0.1",
    "@tabler/icons-react": "^3.44.0",
    "express": "^5.1.0",
    "googleapis": "^150.0.1",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.11.0",
    "next": "16.2.6",
    "nodemailer": "^7.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.29",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.60.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  }
}
