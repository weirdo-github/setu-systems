PORT=4173
HOST=127.0.0.1
NODE_ENV=development

# Shared Postgres database for Setu Systems.
# Local development uses one database with Finance and Discover schemas side-by-side.
# In AWS, point this at RDS/Aurora PostgreSQL and set DATABASE_SSL=true when required.
DATABASE_URL=postgres://setu:setu_dev@127.0.0.1:54322/setu_portal
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_SEED_ON_BOOT=true
DB_SEED_SOURCE=server/storage/app-state.json
DATABASE_SSL=false

# Finance portal login
AUTH_SESSION_SECRET=dev-only-change-me
AUTH_AUDIT_HASH_SALT=replace-with-independent-audit-hash-salt
PORTAL_USERNAME=admin
PORTAL_PASSWORD=setu-local-demo

# Discover portal login and ingestion
SESSION_SECRET=replace-this-local-discover-secret
DISCOVER_URL=http://127.0.0.1:4173/discover
PHASE2_RUN_TOKEN=replace-this-local-phase2-token
PHASE2_SCHEDULE_TIME=06:00
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# Provider integration keys
# Used by machine-to-machine read-only Finance endpoint /api/integration/engagement-status.
INTEGRATION_API_KEY=replace-with-long-random-string
FINANCE_BASE_URL=http://127.0.0.1:4173
FINANCE_INTEGRATION_KEY=replace-with-long-random-string
WEBHOOK_SECRET=replace-with-long-random-webhook-secret

# Outbound email
# Option 1: full SMTP connection string
# SMTP_URL=smtps://username:password@smtp.example.com:465
#
# Option 2: host/user/pass fields
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
# Use a Gmail App Password here when SMTP_USER is a Gmail account.
SMTP_PASS=
SMTP_FROM=

# Invoice content
# Optional. If blank, invoice emails fall back to SMTP_USER and then SMTP_FROM.
ZELLE_PAY_TO=
CARD_PAYMENT_BASE_URL=

# Contract and generated-document storage
# Local development stores files under server/storage. In AWS, use a private S3 bucket.
CONTRACT_STORAGE_DRIVER=local
CONTRACT_STORAGE_DIR=server/storage/contracts
CONTRACT_STORAGE_BUCKET=
CONTRACT_STORAGE_PREFIX=setu-systems/contracts
AWS_REGION=us-east-1

# Gmail inbox polling for Zelle confirmations
GMAIL_CREDENTIALS_PATH=server/credentials/gmail-oauth.json
GMAIL_TOKEN_PATH=server/credentials/gmail-token.json
GMAIL_QUERY='in:inbox subject:"You received money with Zelle"'
GMAIL_MAX_RESULTS=20
GMAIL_INITIAL_LOOKBACK_DAYS=14
GMAIL_SYNC_OVERLAP_MINUTES=15
GMAIL_AUTO_SYNC_ENABLED=true
GMAIL_AUTO_SYNC_INTERVAL_MINUTES=5
GMAIL_AUTO_SYNC_STARTUP_DELAY_SECONDS=15
